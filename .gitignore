
echo "# Python cache" > .gitignore
echo "__pycache__/" >> .gitignore
echo "*.pyc" >> .gitignore
echo "" >> .gitignore
echo "# IDE" >> .gitignore
echo ".idea/" >> .gitignore
echo ".vscode/" >> .gitignore
echo "" >> .gitignore
echo "# Virtual environment" >> .gitignore
echo "venv/" >> .gitignore
echo "env/" >> .gitignore
echo "" >> .gitignore
echo "# Secrets and data" >> .gitignore
echo ".env" >> .gitignore
echo "token.txt" >> .gitignore
echo "wialon_cache.json" >> .gitignore
echo "data/*.json" >> .gitignore